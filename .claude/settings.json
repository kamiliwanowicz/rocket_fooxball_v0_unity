{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/Tools/Tests/Invoke-HarnessTests.ps1",
              "-HookMode",
              "PreToolUse"
            ]
          }
        ]
      }
    ]
  }
}
