{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-context.mjs\"",
            "statusMessage": "Loading AGENTS.md and project skills...",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
